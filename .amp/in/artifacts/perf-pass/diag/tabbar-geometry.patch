       displayLink = nil
     }
 
+    private var diagTicks = 0
+
     @objc private func onDisplayTick() {
       install()
+      diagTicks += 1
+      guard diagTicks % 30 == 1, let window = view.window else { return }
+      let add = addPinFrame(in: window)
+      NSLog("%@", "PERFGEO tick=\(diagTicks) window=\(window.bounds) safe=\(window.safeAreaInsets) addPin=\(add.map { "\($0)" } ?? "nil") assistant=\(assistantButton.map { "\($0.frame) hidden=\($0.isHidden)" } ?? "nil")" as NSString)
+      var bars: [UITabBar] = []
+      func find(_ node: UIView) {
+        if let bar = node as? UITabBar { bars.append(bar) }
+        node.subviews.forEach(find)
+      }
+      find(window)
+      for (index, bar) in bars.enumerated() {
+        func dump(_ node: UIView, depth: Int) {
+          guard depth <= 7 else { return }
+          let frame = node.convert(node.bounds, to: window)
+          let label = node.accessibilityLabel ?? "-"
+          NSLog("%@", "PERFGEO bar\(index) \(String(repeating: ".", count: depth))\(type(of: node)) \(frame) hidden=\(node.isHidden) alpha=\(node.alpha) label=\(label)" as NSString)
+          node.subviews.forEach { dump($0, depth: depth + 1) }
+        }
+        dump(bar, depth: 0)
+      }
     }
 
