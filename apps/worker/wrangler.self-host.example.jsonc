// Self-hosting template for Halation on your own Cloudflare account.
// Copy to wrangler.self-host.jsonc (gitignored) in this folder and fill in the
// placeholders. See docs/self-hosting.md. Paths below are relative to this file.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",

  // Worker name. It becomes <name>.<your-subdomain>.workers.dev.
  "name": "halation",
  "main": "src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "vars": {
    // The id of your plan. Every deployment has its own database, so sharing
    // this value with other instances is harmless. Never change it after setup.
    "HOWMUCH_DEFAULT_PLAN_ID": "0d4f2c1e-6b8a-4e57-9a3c-5f1b7e2d9c40"
    // No HOWMUCH_TIME_ZONE: setup takes the owner's time zone from the browser,
    // and Settings changes it.
    // Deliberately absent:
    //  - No YNAB variables: the one-off YNAB import takes its token per request.
    //  - No HOWMUCH_REDIRECT_TARGET: it would redirect every request elsewhere.
    //  - No HOWMUCH_APPLE_APP_IDS: that claims the iOS app's associated domain
    //    for the owner's signing team, which your domain must not do. Without
    //    it the association file returns 404, which is correct for you.
    // HOWMUCH_API_TOKEN is an optional secret, not a var: see "Optional setup token" in docs/self-hosting.md.
  },

  // Optional custom domain on a zone in your Cloudflare account. Delete this
  // block to use only the workers.dev address.
  // "routes": [{ "pattern": "halation.example.com", "custom_domain": true }],

  // Materialisation of due scheduled transactions. Hourly, so each run uses
  // the plan's own time zone: the first run after its midnight enters the day.
  "triggers": { "crons": ["5 * * * *"] },

  "d1_databases": [{
    "binding": "DB",
    // Name you passed to `wrangler d1 create`.
    "database_name": "halation",
    // The UUID printed by `wrangler d1 create`.
    "database_id": "REPLACE-WITH-D1-DATABASE-ID",
    "migrations_dir": "../api/d1-migrations"
  }],

  // Sampling less keeps you inside the free logging allowance.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
